# Copy to .env; process environment overrides file values.
# Use single quotes for literal secrets containing $ or #. No interpolation in ZigFS.
# Change development credentials before deployment.
ZIGFS_API_ADDRESS="0.0.0.0:9000"

ZIGFS_METRICS_ENABLED=true
ZIGFS_METRICS_ADDRESS="127.0.0.1:9090"

ZIGFS_DATA_ROOT="data"
ZIGFS_STREAM_BUFFER_SIZE=65536

ZIGFS_S3_PUBLIC_ENDPOINT="http://127.0.0.1:9000"
ZIGFS_S3_VIRTUAL_HOSTED_STYLE=false
ZIGFS_S3_REGION="us-east-1"
ZIGFS_S3_REQUEST_TIME_SKEW_SECONDS=900
ZIGFS_S3_MULTIPART_EXPIRY_SECONDS=604800
ZIGFS_S3_LIFECYCLE_SCAN_INTERVAL_SECONDS=300

ZIGFS_ROOT_USER="admin"
ZIGFS_ROOT_PASSWORD="zigfs-admin"
ZIGFS_ADMIN_SESSION_SECRET="zigfs-local-session-secret-change-before-production"
ZIGFS_ADMIN_SESSION_TTL_SECONDS=28800

# Optional root S3 credentials: set both together.
ZIGFS_ACCESS_KEY=
ZIGFS_SECRET_KEY=

# Maintenance and integration
ZIGFS_METADATA_MAINTENANCE_INTERVAL_SECONDS=60
ZIGFS_METADATA_MAINTENANCE_BATCH_SIZE=1000
ZIGFS_KMS_ALLOW_INSECURE_DEV_DEFAULTS=false
ZIGFS_OIDC_PROVIDERS='[]'

# Admin BFF (local). Compose uses its internal service address.
ZIGFS_ADMIN_LISTEN=:9001
ZIGFS_ENDPOINT=http://127.0.0.1:9000
ZIGFS_UPSTREAM_TIMEOUT=15m
# ZIGFS_WEB_ROOT=../web/dist
# ZIGFS_ADMIN_CONFIG=/absolute/path/zigfs-admin/listener.json

# Compose published ports
ZIGFS_API_PORT=9000
ZIGFS_METRICS_PORT=9090
ZIGFS_ADMIN_PORT=9001
