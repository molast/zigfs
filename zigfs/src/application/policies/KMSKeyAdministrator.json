{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:ListKeys",
        "kms:EnableKey",
        "kms:DisableKey",
        "kms:RotateKey",
        "kms:DeleteKey"
      ],
      "Resource": [
        "arn:aws:kms:::*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "sts:AssumeRole"
      ]
    }
  ]
}
